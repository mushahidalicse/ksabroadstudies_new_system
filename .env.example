# PostgreSQL connection string for portal accounts.
# Required wherever the portal runs. Production does not fall back to JSON or /tmp.
# Add this in Vercel: Project → Settings → Environment Variables → DATABASE_URL
# Use Vercel Postgres, Neon, or any managed PostgreSQL. Example:
# postgres://USER:PASSWORD@HOST:5432/ks_abroad?sslmode=require
# Local development:
#   npm run db:start   starts 127.0.0.1:54329 database ks_abroad and exits 0
#   npm run db:stop    stops that server and exits 0
#   npm run dev        starts the database if needed, then one Next.js server on port 43127
# The cluster lives in data/pg/cluster. data/pg itself is not a data directory.
# Do not paste the password into source files.
DATABASE_URL=
# Production document files. Leave unset in local development (files stay in data/uploads).
# Do not set this to /tmp. Metadata is in PostgreSQL; file bytes need a persistent disk
# or object storage. Until UPLOAD_DIR is a real persistent path, production uploads fail closed.
UPLOAD_DIR=
ADMIN_PASSWORD=
# Local programme research only. Do not add these keys to Vercel in this phase.
# Keys are read on the server. They are never sent to the browser.
# RESEARCH_PROVIDER=openai uses the existing OPENAI_API_KEY. Leave it unset for the same default.
# RESEARCH_PROVIDER=mock exercises the desk without an API call.
# RESEARCH_PROVIDER=grok is optional and unused unless XAI_API_KEY is set later.
# OPENAI_BUDDY_MODEL is KS Buddy only. OPENAI_RESEARCH_MODEL is programme research only.
RESEARCH_PROVIDER=openai
OPENAI_RESEARCH_MODEL=gpt-5.5
RESEARCH_MAX_TOOL_CALLS=6
RESEARCH_URL_DISCOVERY_PASSES=2
RESEARCH_ADMISSION_SEARCH_PASSES=2
RESEARCH_SEARCH_CONTEXT=low
RESEARCH_MAX_OUTPUT_TOKENS=1600
RESEARCH_REASONING_EFFORT=low
XAI_API_KEY=
XAI_MODEL=grok-4.5
SESSION_SECRET=
PORTAL_JWT_SECRET=
# Public canonical URL for sitemap, robots, Open Graph, llms.txt
NEXT_PUBLIC_SITE_URL=http://localhost:43127
# Optional: comma-separated extra hosts allowed for browser POST (CSRF)
TRUSTED_ORIGINS=
# Optional: lock /api/v1 bulk catalogue behind header x-api-key
CATALOGUE_API_KEY=
# Public page / JSON catalogue cache TTL (seconds)
CACHE_REVALIDATE_SECONDS=120
# Bump when Privacy Policy materially changes (forces fresh consent text)
CONSENT_POLICY_VERSION=2026-09-20
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BUDDY_MODEL=gpt-4o-mini
RESEND_API_KEY=
RESEND_FROM=KS Abroad <onboarding@resend.dev>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
CONTACT_TO_EMAIL=
